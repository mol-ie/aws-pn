# Kiro SCIM configuration.
# Copy this file to ".env" and place it in the same directory as the kiro-scim
# binary. Fill in the values from the Kiro admin console
# (Settings -> Identity Management).
#
# The SCIM endpoint must be an https URL in one of Kiro's supported regions:
#   us-east-1 or eu-central-1
# It has the shape: https://scim.<region>.amazonaws.com/<tenant-id>/scim/v2
KIRO_SCIM_ENDPOINT=https://scim.us-east-1.amazonaws.com/<tenant-id>/scim/v2

# The SCIM bearer token. Treat this like a password: it is a long-lived
# credential. Never commit it to source control.
KIRO_SCIM_TOKEN=<bearer-token>
